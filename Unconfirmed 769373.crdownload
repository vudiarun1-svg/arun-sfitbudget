    ('Canned Green Beans', 'Vegetable', 8.99, 12, 40, 2, 8, 0, 3, 0, 1, 0, 0),
    ('Frozen Stir Fry Vegetables', 'Vegetable', 12.99, 16, 60, 3, 11, 0, 4, 0, 1, 0, 0),
    ('Frozen Cauliflower Rice', 'Vegetable', 11.99, 16, 30, 2, 5, 0, 2, 0, 1, 0, 0),
    ('Frozen Avocado Chunks', 'Healthy Fat', 13.99, 12, 150, 2, 8, 13, 6, 0, 0, 1, 0),
    ('Frozen Sweet Potato Fries', 'Carb', 12.99, 14, 150, 2, 25, 5, 3, 0, 0, 0, 0),
    ('Whole Grain Cereal Squares', 'Carb', 10.99, 20, 180, 6, 40, 2, 6, 0, 0, 0, 1),
    ('Corn Flakes', 'Carb', 8.99, 24, 140, 3, 32, 0, 1, 0, 0, 0, 0),
    ('Frosted Flakes', 'Carb', 8.99, 24, 150, 2, 36, 0, 1, 0, 0, 0, 0),
    ('Rice Cereal', 'Carb', 8.99, 24, 150, 3, 34, 0, 1, 0, 0, 0, 0),
    ('Protein Granola', 'Carb', 14.99, 18, 200, 10, 28, 6, 5, 0, 0, 0, 1),
    ('Trail Mix', 'Healthy Fat', 15.99, 24, 180, 5, 20, 10, 3, 0, 0, 1, 0),
]

foods = pd.DataFrame(food_data, columns=columns)

print("======================================")
print("          FITBUDGET OPTIMIZER")
print("======================================")
print()

budget = float(input("Grocery budget ($): "))
days = int(input("How many days should groceries last? "))
daily_calories = int(input("Daily calorie target: "))
daily_protein = int(input("Minimum daily protein (g): "))

print("\nLoaded", len(foods), "food items.")

calorie_low = daily_calories * 0.97
calorie_high = daily_calories * 1.03
fiber_min = 14 * daily_calories / 1000
fat_min = (daily_calories * 0.20) / 9
fat_max = (daily_calories * 0.35) / 9

model = pulp.LpProblem("FitBudget", pulp.LpMinimize)

packages = {}
servings = {}

for i, row in foods.iterrows():
    packages[i] = pulp.LpVariable(
        f"packages_{i}",
        lowBound=0,
        upBound=6,
        cat="Integer"
    )

for day in range(days):
    for i, row in foods.iterrows():
        servings[(day, i)] = pulp.LpVariable(
            f"day_{day}_food_{i}",
            lowBound=0,
            upBound=3,
            cat="Continuous"
        )

total_cost = pulp.lpSum(
    packages[i] * foods.loc[i, "price_estimate"]
    for i in foods.index
)

model += total_cost + 0.03 * pulp.lpSum(
    packages[i] for i in foods.index
)

model += total_cost <= budget

for day in range(days):
    calories = pulp.lpSum(
        servings[(day, i)] * foods.loc[i, "calories_per_serving"]
        for i in foods.index
    )

    protein = pulp.lpSum(
        servings[(day, i)] * foods.loc[i, "protein_g"]
        for i in foods.index
    )

    fat = pulp.lpSum(
        servings[(day, i)] * foods.loc[i, "fat_g"]
        for i in foods.index
    )

    fiber = pulp.lpSum(
        servings[(day, i)] * foods.loc[i, "fiber_g"]
        for i in foods.index
    )

    fruit = pulp.lpSum(
        servings[(day, i)] * foods.loc[i, "fruit_serving"]
        for i in foods.index
    )

    vegetables = pulp.lpSum(
        servings[(day, i)] * foods.loc[i, "vegetable_serving"]
        for i in foods.index
    )

    healthy_fat = pulp.lpSum(
        servings[(day, i)] * foods.loc[i, "healthy_fat_serving"]
        for i in foods.index
    )

    whole_grain = pulp.lpSum(
        servings[(day, i)] * foods.loc[i, "whole_grain_serving"]
        for i in foods.index
    )

    model += calories >= calorie_low
    model += calories <= calorie_high
    model += protein >= daily_protein
    model += fat >= fat_min
    model += fat <= fat_max
    model += fiber >= fiber_min
    model += fruit >= 1
    model += vegetables >= 1.5
    model += healthy_fat >= 0.5
    model += whole_grain >= 0.5

for i, row in foods.iterrows():
    total_eaten = pulp.lpSum(
        servings[(day, i)]
        for day in range(days)
    )

    total_available = (
        packages[i] * row["servings_per_package"]
    )

    model += total_eaten <= total_available

solver = pulp.PULP_CBC_CMD(msg=False)
model.solve(solver)

status = pulp.LpStatus[model.status]

print("\n======================================")
print("          OPTIMIZATION RESULT")
print("======================================")
print("Status:", status)

if status != "Optimal":
    print("\nNo balanced meal plan was found.")
    print("Try increasing your budget or lowering your protein target.")

else:
    grocery_rows = []
    actual_cost = 0

    for i, row in foods.iterrows():
        amount = packages[i].value()

        if amount is not None and amount > 0:
            item_cost = amount * row["price_estimate"]
            actual_cost += item_cost

            grocery_rows.append({
                "Food": row["name"],
                "Packages": int(round(amount)),
                "Estimated Cost": round(item_cost, 2)
            })

    grocery_df = pd.DataFrame(grocery_rows)

    print("\n======================================")
    print("        RECOMMENDED GROCERIES")
    print("======================================")
    print(grocery_df.to_string(index=False))

    daily_plan = []

    for day in range(days):
        day_calories = 0
        day_protein = 0
        day_carbs = 0
        day_fat = 0
        day_fiber = 0
        food_list = []

        for i, row in foods.iterrows():
            amount = servings[(day, i)].value()

            if amount is not None and amount > 0.05:
                day_calories += amount * row["calories_per_serving"]
                day_protein += amount * row["protein_g"]
                day_carbs += amount * row["carbs_g"]
                day_fat += amount * row["fat_g"]
                day_fiber += amount * row["fiber_g"]

                food_list.append(
                    row["name"] + " (" + str(round(amount, 2)) + " servings)"
                )

        daily_plan.append({
            "Day": day + 1,
            "Calories": round(day_calories),
            "Protein": round(day_protein),
            "Carbs": round(day_carbs),
            "Fat": round(day_fat),
            "Fiber": round(day_fiber),
            "Foods": ", ".join(food_list)
        })

    plan_df = pd.DataFrame(daily_plan)

    print("\n======================================")
    print("            DAILY DIET PLAN")
    print("======================================")
    print(plan_df.to_string(index=False))

    avg_calories = plan_df["Calories"].mean()
    avg_protein = plan_df["Protein"].mean()
    avg_carbs = plan_df["Carbs"].mean()
    avg_fat = plan_df["Fat"].mean()
    avg_fiber = plan_df["Fiber"].mean()

    money_left = budget - actual_cost
    daily_cost = actual_cost / days

    print("\n======================================")
    print("          FITBUDGET SUMMARY")
    print("======================================")
    print(f"Budget: ${budget:.2f}")
    print(f"Estimated grocery cost: ${actual_cost:.2f}")
    print(f"Money remaining: ${money_left:.2f}")
    print(f"Cost per day: ${daily_cost:.2f}")
    print(f"Average calories/day: {avg_calories:.0f}")
    print(f"Average protein/day: {avg_protein:.0f} g")
    print(f"Average carbs/day: {avg_carbs:.0f} g")
    print(f"Average fat/day: {avg_fat:.0f} g")
    print(f"Average fiber/day: {avg_fiber:.0f} g")

    plt.figure(figsize=(12, 6))
    plt.bar(grocery_df["Food"], grocery_df["Estimated Cost"])
    plt.title("FitBudget Grocery Cost Breakdown")
    plt.xlabel("Food")
    plt.ylabel("Cost ($)")
    plt.xticks(rotation=75)
    plt.tight_layout()
    plt.show()

    plt.figure(figsize=(10, 5))
    plt.plot(plan_df["Day"], plan_df["Protein"], marker="o")
    plt.axhline(daily_protein, linestyle="--")
    plt.title("Daily Protein")
    plt.xlabel("Day")
    plt.ylabel("Protein (g)")
    plt.tight_layout()
    plt.show()

    plt.figure(figsize=(10, 5))
    plt.plot(plan_df["Day"], plan_df["Calories"], marker="o")
    plt.axhline(daily_calories, linestyle="--")
    plt.title("Daily Calories")
    plt.xlabel("Day")
    plt.ylabel("Calories")
    plt.tight_layout()
    plt.show()